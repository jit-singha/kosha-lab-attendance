rules_version = '2';

// Kosha Lab Attendance Tracker — Firestore security rules.
// The owner email below must match OWNER_EMAIL in firebase-config.js.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email == 'js0234092@gmail.com'; }
    function myDoc() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(myDoc()); }
    function me() { return get(myDoc()).data; }
    function isAdmin() { return isOwner() || (isMember() && me().role == 'admin'); }
    // Everyone in Operations (and admins) logs devices and damage. The IT department can view them.
    function isOperator() { return isAdmin() || (isMember() && me().get('dept', '') == 'Operations'); }
    function canViewDevices() { return isOperator() || (isMember() && me().get('dept', '') == 'IT'); }
    function validDept() { return request.resource.data.get('dept', '') in ['', 'Operations', 'IT', 'Data Analysis', 'HR', 'Finance']; }
    // People pick their department once (at sign-up, or later if it's empty); after that only admins change it.
    function deptOk() {
      return request.resource.data.get('dept', '') == resource.data.get('dept', '')
        || (resource.data.get('dept', '') == '' && validDept());
    }
    // HR (and admins) see everyone's attendance, correct it and decide leave. HR can't do this for themselves.
    function isHR() { return isAdmin() || (isMember() && me().get('dept', '') == 'HR'); }
    function hrFor(uid) { return isAdmin() || (isHR() && uid != request.auth.uid); }
    function validMark() { return request.resource.data.get('mark', null) == null || request.resource.data.mark in ['present', 'absent', 'week_off', 'casual', 'sick', 'paid']; }
    function validShift() { return request.resource.data.get('shift', 'day') in ['day', 'night']; }
    // Device records hold a mix of types: counts = { '03W': n, 'Pi': n, 'Cubic': n }, at least one device in total.
    function cnt(d, t) { return d.counts.get(t, 0); }
    function validDevice(d) {
      return d.uid == request.auth.uid && d.counts is map && d.counts.keys().hasOnly(['03W', 'Pi', 'Cubic'])
        && cnt(d, '03W') is int && cnt(d, 'Pi') is int && cnt(d, 'Cubic') is int
        && cnt(d, '03W') >= 0 && cnt(d, 'Pi') >= 0 && cnt(d, 'Cubic') >= 0
        && cnt(d, '03W') + cnt(d, 'Pi') + cnt(d, 'Cubic') > 0;
    }
    // Extra items on a deployment: { sd, flood, power, otg, samsung, oppo } counts, plus up to 20 other items.
    function validExtras(d) {
      return d.get('extras', {}) is map
        && d.get('extras', {}).keys().hasOnly(['sd', 'flood', 'power', 'otg', 'samsung', 'oppo'])
        && d.get('others', []) is list && d.get('others', []).size() <= 20;
    }
    function nearNow(ts) { return ts is int && ts > request.time.toMillis() - 300000 && ts < request.time.toMillis() + 300000; }

    // Profiles. People create their own profile only as a "member", choosing their department once and
    // their Day / Night shift any time; only admins can set roles, change departments, or remove people.
    match /users/{uid} {
      allow read: if isHR() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'member'
            && validDept() && validShift());
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role && deptOk() && validShift());
      allow delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Logo: anyone can read it (shown on the sign-in page); only admins can change it.
    match /branding/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Attendance: members write only their own record, with a timestamp close to server time.
    // HR can mark anyone else's day (present, absent or a leave type) without touching their check-in data.
    match /attendance/{id} {
      allow read: if isHR() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if (isMember() && request.resource.data.uid == request.auth.uid
          && id == request.auth.uid + '_' + request.resource.data.date
          && nearNow(request.resource.data.inTs)
          && request.resource.data.get('lateReason', '') is string && request.resource.data.get('lateReason', '').size() <= 300)
        || (hrFor(request.resource.data.uid) && validMark()
          && id == request.resource.data.uid + '_' + request.resource.data.date
          && request.resource.data.keys().hasOnly(['id', 'uid', 'name', 'date', 'shift', 'mark', 'markedBy', 'markedByName', 'markedAt']));
      allow update: if (isMember() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.inTs == resource.data.inTs
          && resource.data.outTs == null && nearNow(request.resource.data.outTs))
        || (hrFor(resource.data.uid) && validMark()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mark', 'markedBy', 'markedByName', 'markedAt']));
      allow delete: if isAdmin();
    }

    // Leave: everyone requests their own (pending); HR approves or rejects; people can cancel their own pending requests.
    match /leaves/{id} {
      allow read: if isHR() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if isMember() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['week_off', 'casual', 'sick', 'paid']
        && request.resource.data.from is string && request.resource.data.to is string
        && request.resource.data.to >= request.resource.data.from;
      allow update: if hrFor(resource.data.uid) && request.resource.data.uid == resource.data.uid
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // Laptop take-home requests: members create pending requests; admins approve / reject / mark returned.
    match /laptops/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if isMember() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Device deployments and damage reports: Operations, admins and the IT department see all of them;
    // Operations members add their own and can edit or delete only their own; admins can change any; IT only views.
    match /deployments/{id} {
      allow read: if canViewDevices();
      allow create: if isOperator() && validDevice(request.resource.data) && validExtras(request.resource.data);
      allow update: if isAdmin() || (isOperator() && resource.data.uid == request.auth.uid && validDevice(request.resource.data) && validExtras(request.resource.data));
      allow delete: if isAdmin() || (isOperator() && resource.data.uid == request.auth.uid);
    }
    match /damages/{id} {
      allow read: if canViewDevices();
      allow create: if isOperator() && validDevice(request.resource.data);
      allow update: if isAdmin() || (isOperator() && resource.data.uid == request.auth.uid && validDevice(request.resource.data));
      allow delete: if isAdmin() || (isOperator() && resource.data.uid == request.auth.uid);
    }
  }
}
